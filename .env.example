DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Local development uses SQLite by default. Docker Compose sets DB_ENGINE=postgres.
# These values are local examples; set a unique strong password before deployment.
POSTGRES_DB=fish_ecommerce
POSTGRES_USER=fish_ecommerce
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-another-long-random-secret
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
