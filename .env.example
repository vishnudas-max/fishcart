DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
NEXT_PUBLIC_STORE_PHONE=9539833135
NEXT_PUBLIC_SITE_URL=
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Local development uses SQLite by default. Docker Compose sets DB_ENGINE=postgres.
# These values are local examples; set a unique strong password before deployment.
POSTGRES_DB=fish_ecommerce
POSTGRES_USER=fish_ecommerce
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace-with-another-long-random-secret
# Configure this with your SMTP provider details for OTP delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Thatt <no-reply@example.com>

# Choose exactly one order alert provider: telegram, whatsapp, or disabled.
ORDER_NOTIFICATION_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp alternative; configure a Meta app and an approved template with seven body placeholders.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v27.0

# Checkout uses straight-line distance and OpenStreetMap tiles; no paid map key is needed.
