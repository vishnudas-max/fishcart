            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('scheduledFor', new Date(Date.now() + 48 * 60 * 60 * 1000).toISOString());"
                ]
