          },
          "description": "Public endpoint returns visible reviews. An authenticated customer can also see their own hidden review. Responses do not expose customer usernames or phone numbers."
        },
        {
          "name": "Create verified-purchase review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Fresh and cleaned well\"\n}"
            },
            "url": "{{baseUrl}}/api/catalog/products/{{productSlug}}/reviews/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('productReviewId', String(pm.response.json().id));"
                ]
              }
            }
          ],
          "description": "Requires customer access token and a completed order containing this product. One review per customer per product; rating is 1-5."
        },
        {
          "name": "Update my review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
